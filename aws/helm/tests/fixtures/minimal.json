  "helm_values": "\"global\":\n  \"AWS_ACCOUNT_ID\": \"example-account-id\"\n  \"AWS_REGION\": \"us-east-2\"\n  \"BACKEND_IAM_ROLE_ARN\": \"arn:aws:iam::example-account-id:role/test-dp-union-system\"\n  \"CLUSTER_NAME\": \"test-dp\"\n  \"FAST_REGISTRATION_BUCKET\": \"test-dp-abcd1234-fast-reg\"\n  \"METADATA_BUCKET\": \"test-dp-abcd1234-metadata\"\n  \"WORKER_IAM_ROLE_ARN\": \"arn:aws:iam::example-account-id:role/test-dp-union-system\"\n\"imageBuilder\":\n  \"registryName\": \"test-dp\"\n",
  "iam_role_arn": "arn:aws:iam::example-account-id:role/test-dp-union-system",
  "kubeconfig_command": "aws eks update-kubeconfig --name test-dp --region us-east-2",
